rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Shared Resource Files (PDF, DOCX, ZIP, Images)
    match /resources/{userId}/{fileName} {
      allow read: if request.auth != null;
      
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024; // Max 25MB
    }

    // Past Examination Paper Files
    match /past_papers/{userId}/{fileName} {
      allow read: if request.auth != null;
      
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024; // Max 25MB
    }

    // Student Marketplace Listing Images
    match /marketplace/{userId}/{fileName} {
      allow read: if request.auth != null;
      
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // Max 10MB per image
    }
  }
}
